# Copy this file to .env for a project-local override.
#
# You do NOT need to set anything to run this project — LLM_PROVIDER
# defaults to "mock" (see app/config.py), which needs zero keys and zero
# network access. Set LLM_PROVIDER below once you want a real model.
#
# Key names are accepted in either case (OPENAI_API_KEY or
# openai_api_key), because real secrets files disagree about this and a
# silent case mismatch is a miserable thing to debug.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Free tier, no credit card required: https://console.groq.com/keys
GROQ_API_KEY=

# NOTE: rebuilding data/ from source (python data/refresh_data.py) needs
# no credentials at all — every data source used is keyless. See
# DECISIONS.md for why the Census Data API (which does need a key) was
# dropped in favour of Census's published flat files.

# Provider selection — the AI_PROVIDER pattern. mock | openai | anthropic | groq
LLM_PROVIDER=mock

OPENAI_LLM_MODEL=gpt-4o-mini
ANTHROPIC_LLM_MODEL=claude-haiku-4-5-20251001
GROQ_LLM_MODEL=llama-3.3-70b-versatile

HOST=127.0.0.1
PORT=8000

# ── Voice (optional — the brief's bonus) ────────────────────────────────
# Nothing here needs to be set. Without it, the UI still offers the
# browser's own Web Speech API for dictation and read-aloud, at no cost.
#
# With OPENAI_API_KEY above set, conversation mode also works: an open
# microphone, real speech models, spoken replies, and barge-in. Both
# speech providers default to OpenAI on purpose — the app already needs
# that key for the agent, so voice adds no second credential.
STT_PROVIDER=openai
TTS_PROVIDER=openai

OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_FALLBACK_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_VOICE=alloy

# Google Cloud Text-to-Speech, only if you set TTS_PROVIDER=google.
# A second real implementation behind the same interface — see
# app/providers/tts/google_tts.py for why it exists.
GCP_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-US-Neural2-C
GOOGLE_TTS_LANGUAGE_CODE=en-US
